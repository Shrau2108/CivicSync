# CivicSync Supabase Configuration
# Replace these with your Supabase project URL and anon public key from Project Settings > API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Optional: Google Maps API Key for Live Maps
VITE_GOOGLE_MAPS_API_KEY=

# Set to true to force demo mode even if Supabase credentials are present
VITE_DEMO_MODE=false
